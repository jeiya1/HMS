# --- Database (read by config/connect.php via env.php) ---
DB_HOST=db
DB_PORT=3306
DB_DATABASE=HMS
DB_USERNAME=root
DB_PASSWORD=rootpass

# --- Also used by docker-compose.yml directly for the db container ---
DB_ROOT_PASSWORD=rootpass

# --- PHPMailer (used in app/models/User.php + Reservation.php) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM=your-email@example.com
MAIL_FROM_NAME="Hotel Management System"
